# SatQuery AI — environment configuration
#
# Copy this file to `.env.local` and fill in values from your Supabase project
# dashboard (Project Settings → API). You can also set these in the NativelyAI
# platform's Environment settings instead — the app reads them at build time.
#
# These two variables are PUBLIC config (the anon key is designed to be shipped
# to browsers). Secret keys such as the Gemini API key never belong here — they
# live in the Supabase Edge Function `satquery-analyze` secrets.
#
# Without these, the app still boots in DEMO MODE: you get the bundled sample
# scenes and a simulated analysis pipeline, but sign-in, live Gemini analysis
# and saved reports are disabled until the values are filled in.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key